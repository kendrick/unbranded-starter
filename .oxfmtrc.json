{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": true,
	"singleQuote": true,
	"arrowParens": "always",
	"trailingComma": "all",
	"quoteProps": "consistent",
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": [
		"dist/**",
		"CHANGELOG.md",
		".release-please-manifest.json",
		"pnpm-lock.yaml",
		".agent-guild/**",
		".specify/**",
		"**/.specify/**",
		"CLAUDE.md",
		"AGENTS.md",
		".claude/**",
		".agents/**"
	]
}
