{
	"name": "unbranded",
	"type": "module",
	"version": "2.0.5",
	"packageManager": "pnpm@10.0.0",
	"description": "Interactive CLI to scaffold your preferred project tooling into any project, using your existing package manager.",
	"author": "Kendrick Arnett",
	"license": "MIT",
	"homepage": "https://github.com/kendrick/unbranded-starter#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kendrick/unbranded-starter.git"
	},
	"bugs": "https://github.com/kendrick/unbranded-starter/issues",
	"keywords": [
		"scaffold",
		"scaffolding",
		"cli",
		"generator",
		"boilerplate",
		"starter",
		"project-setup",
		"developer-tools",
		"eslint",
		"typescript",
		"tailwindcss",
		"vitest",
		"stylelint",
		"package-manager"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli": "./dist/cli.js",
		"./schemas/*": "./schemas/*"
	},
	"bin": {
		"unbranded": "./dist/cli.js"
	},
	"files": [
		".editorconfig",
		"AGENTS.md",
		"dist",
		"docs",
		"opt-in",
		"postcss.config.mjs",
		"presets",
		"schemas",
		"stylelint.config.mjs",
		"templates",
		"tsconfig.base.json",
		"vitest.config.ts"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"prepublishOnly": "pnpm build",
		"prepare": "simple-git-hooks",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
		"test:all": "pnpm test && pnpm test:e2e",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:css": "stylelint \"**/*.css\" --allow-empty-input",
		"lint:css:fix": "stylelint \"**/*.css\" --fix --allow-empty-input",
		"format": "oxfmt"
	},
	"dependencies": {
		"@clack/core": "1.3.1",
		"@clack/prompts": "1.4.0",
		"diff": "9.0.0",
		"node-diff3": "3.2.1"
	},
	"devDependencies": {
		"@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
		"@tailwindcss/postcss": "^4.0.0",
		"@types/node": "^26.6.4",
		"ajv": "8.20.0",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"simple-git-hooks": "^2.13.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.0.0",
		"tsdown": "0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint-staged",
		"pre-push": "CI=true pnpm lint"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts}": [
			"oxlint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{json,jsonc,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern",
		"*.css": "stylelint --fix"
	}
}
