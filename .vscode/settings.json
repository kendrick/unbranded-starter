{
	// Format on save with oxfmt, then apply oxlint's fixes. "file" mode formats
	// the whole file, which is what lint-staged's oxfmt run does at commit.
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
		"source.fixAll.stylelint": "explicit"
	},
	"editor.defaultFormatter": "oxc.oxc-vscode",

	// Tabs (matching .editorconfig and .oxfmtrc.json)
	"editor.insertSpaces": false,
	"editor.tabSize": 2,
	"editor.detectIndentation": false,

	// Stylelint
	"stylelint.validate": ["css", "postcss", "scss"],

	// Per-language overrides — CSS gets stylelint as default formatter
	"[css]": {
		"editor.defaultFormatter": "stylelint.vscode-stylelint"
	},
	"[postcss]": {
		"editor.defaultFormatter": "stylelint.vscode-stylelint"
	},

	// JSON, JSONC, Markdown, and MDX: oxc.oxc-vscode runs oxfmt, so a save
	// writes what `oxfmt --check` in `pnpm lint` accepts. These repeat the
	// default above because a user's own `[json]` or `[markdown]` setting
	// outranks a workspace default. VS Code's built-in JSON formatter
	// expands objects and arrays that oxfmt keeps inline, so a save with it
	// can fail lint. `.oxfmtrc.json` ignores `.claude/**`, so saves there may
	// not format, and lint skips those files too.
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[mdx]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},

	// Search / file watcher exclusions (matches .gitignore)
	"search.exclude": {
		"**/node_modules": true,
		"**/.next": true,
		"**/dist": true,
		"**/out": true,
		"**/build": true,
		"**/.turbo": true,
		"pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/.next/**": true,
		"**/dist/**": true,
		"**/out/**": true,
		"**/build/**": true,
		"**/.turbo/**": true
	},

	// TypeScript: use workspace version, not VS Code's bundled one
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,

	// Tailwind v4 — official extension picks this up via CSS @theme
	"tailwindCSS.experimental.classRegex": [
		["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
		["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
	]
}
